# Copy to backend/.env and fill in real values (scripts/setup.* does this and generates the secrets).
APP_NAME="Ananta Graphics"
# development | production
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ananta_graphics

# Generated by setup. Manually: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public website origin(s) -> public API (8000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CMS origin(s) -> admin API (8001)
ADMIN_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Public website + CMS URLs (used in enquiry emails)
SITE_URL=http://localhost:3000
CMS_URL=http://localhost:3001
# After CMS edits the admin API asks the website to refresh its cache.
# Must match REVALIDATE_SECRET in frontend/.env.local (setup keeps them in sync). Empty = disabled.
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
REVALIDATE_SECRET=

# Enquiry notification email (SMTP). Optional — can be configured anytime in the CMS Dashboard (Settings -> Email).
# Leave empty if you don't need immediate email alerts (all enquiries are always saved in the CMS).
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_NOTIFY_TO=
