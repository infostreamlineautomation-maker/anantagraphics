# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
backend/venv/
backend/.venv/
backend/.env
# CMS uploads stay on the server; Figma and seeded media (reels, services) are versioned so deploys get it
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/figma/
!backend/uploads/reels/
!backend/uploads/services/

# Node / Next (each app also has its own .gitignore)
node_modules/
.next/
*.tsbuildinfo

# Env
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

